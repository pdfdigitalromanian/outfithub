# =============================================================================
# OutfitHub environment variables
# Copy the BACKEND section to apps/backend/.env and the STOREFRONT section to
# apps/storefront/.env.local (or to your hosting provider's env settings).
# Never commit real values. Integration credentials (Google, Meta, TikTok,
# Sameday, GA4 API secret) are entered in Medusa Admin → Integrations and
# stored encrypted in the database — not here.
# =============================================================================

# ----------------------------------------------------------------------------- APP
# Public URL of the storefront (used for canonical URLs, sitemap, product links
# sent to Google/Meta/TikTok, email links).
STOREFRONT_URL=http://localhost:3000
# Public URL of the Medusa backend (admin at /app, OAuth callbacks, AWB labels).
MEDUSA_BACKEND_URL=http://localhost:9000
NODE_ENV=development

# ------------------------------------------------------------------------ DATABASE
# Supabase: Project Settings → Database → Connection string → "Session pooler"
# (port 5432). Example:
# postgres://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outfithub
# Set to true for managed Postgres that requires TLS (Supabase, Neon, RDS).
DATABASE_SSL=false

# -------------------------------------------------------------------------- MEDUSA
# Generate each with: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Comma-separated origins allowed to call the APIs.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
# 32-byte hex key used to encrypt integration credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32   — losing it makes stored credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# "shared" (single instance) | "server" + "worker" (two instances in production)
MEDUSA_WORKER_MODE=shared
# Set true on the worker instance.
DISABLE_MEDUSA_ADMIN=false
MEDUSA_DISABLE_TELEMETRY=true

# --------------------------------------------------------------------------- REDIS
# Required in production (event bus, workflow engine, caching, locking).
# Upstash / Redis Cloud / Railway: use the rediss:// URL.
REDIS_URL=redis://localhost:6379
# Optional dedicated instances (default to REDIS_URL)
CACHE_REDIS_URL=
LOCKING_REDIS_URL=

# ------------------------------------------------------------------------ SUPABASE
# Product images via Supabase Storage (S3-compatible). Storage → Settings → S3
# connection: enable, create access keys, create a PUBLIC bucket "products".
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket objects:
S3_FILE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/products
S3_FORCE_PATH_STYLE=true

# -------------------------------------------------------------------------- GOOGLE
# Google Merchant Center + GA4 credentials are configured in
# Admin → Integrations (service account JSON, merchant ID, measurement ID).
# Nothing required here.

# ---------------------------------------------------------------------------- META
# Configured in Admin → Integrations → Meta (pixel ID, catalog ID, system user
# token, app secret). Webhook URL: ${MEDUSA_BACKEND_URL}/webhooks/meta

# -------------------------------------------------------------------------- TIKTOK
# Configured in Admin → Integrations → TikTok Pixel & Events / TikTok Shop.
# TikTok Shop redirect URL: ${MEDUSA_BACKEND_URL}/integrations/tiktok-shop/callback
# TikTok Shop webhook URL:  ${MEDUSA_BACKEND_URL}/webhooks/tiktok-shop

# ------------------------------------------------------------------------- SAMEDAY
# Configured in Admin → Integrations → Sameday (API username/password,
# pickup point, services).
# Optional: point the client at a staging/mock API (QA only, leave empty in production)
SAMEDAY_API_HOST=

# ----------------------------------------------------------------------- ANALYTICS
# Public IDs (GA4, GTM, Meta Pixel, TikTok Pixel) are set in the admin and
# delivered to the storefront at runtime through /store/content.

# --------------------------------------------------------------------------- EMAIL
# Without SendGrid, emails are written to the backend log (development).
SENDGRID_API_KEY=
SENDGRID_FROM=comenzi@exemplu.ro
# SendGrid dynamic template IDs (d-xxxxxxxx)
SENDGRID_TEMPLATE_ORDER_PLACED=
SENDGRID_TEMPLATE_PASSWORD_RESET=
SENDGRID_TEMPLATE_SHIPMENT=

# ------------------------------------------------------------------------ PAYMENTS
# Cash on delivery (ramburs) works without configuration.
# Stripe (optional): Dashboard → Developers → API keys / Webhooks.
# Webhook endpoint: ${MEDUSA_BACKEND_URL}/hooks/payment/stripe_stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------ STOREFRONT (Next.js)
# (apps/storefront/.env.local or Vercel → Project → Settings → Environment Variables)
MEDUSA_BACKEND_URL=http://localhost:9000
# Medusa Admin → Settings → Publishable API Keys (printed by `npm run seed`).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=ro
# Shared secret for on-demand cache purge. Must equal STOREFRONT_REVALIDATE_SECRET on the backend.
REVALIDATE_SECRET=
STOREFRONT_REVALIDATE_SECRET=
# Optional: Stripe publishable key (enables card payments in checkout)
NEXT_PUBLIC_STRIPE_KEY=
# Optional: extra image host (e.g. your Supabase project host) for next/image
NEXT_PUBLIC_IMAGE_HOST=
# Set true on staging to block indexing
NEXT_PUBLIC_NOINDEX=false
